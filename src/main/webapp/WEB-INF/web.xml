<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         version="3.1"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

    <display-name>Туристическое агентство</display-name>

    <context-param>
        <param-name>defaultEncoding</param-name>
        <param-value>UTF-8</param-value>
    </context-param>

    <!-- Сервлет для туров -->
    <servlet>
        <servlet-name>TourServlet</servlet-name>
        <servlet-class>com.tourism.web.TourServlet</servlet-class>
        <init-param>
            <param-name>toursResource</param-name>
            <param-value>data/tours.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- Сервлет для авторизации -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.tourism.web.AuthServlet</servlet-class>
        <init-param>
            <param-name>usersResource</param-name>
            <param-value>data/users.xml</param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>TourServlet</servlet-name>
        <url-pattern>/tours</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
    </servlet-mapping>

    <!-- Фильтр для проверки авторизации -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.tourism.web.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/tours</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>